<?xml version="1.0" encoding="utf-8" ?>
<component  name="DetailsScreen" 
            extends="Group" 
            initialFocus="buttons" 
            xsi:noNamesSpaceSchemaLocation="https://devtools.web.roku.com/schema/RokuSceneGraph.xsd">
    <script type="text/brightscript" uri="DetailsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils.brs" />

    <interface>
        <field id="content" type="node" />
        <field id="jumpToItem" type="integer" onChange="OnJumpToItem" value="0" alwaysNotify="true" />
        <field id="itemFocused" type="integer" alwaysNotify="true" />
        <field id="buttonSelected" type="integer" alias="buttons.itemSelected" />
    </interface>

    <children>
        <LayoutGroup
            id="infoGroup"
            translation="[128, 170]"
            layoutDirection="vert"
            itemSpacings="[20, 20]"
        >
            <Rectangle
                width="500"
                height="300"
                color="0xFFFFFF"
            >
                <Poster 
                    id="poster"
                    width="500"
                    loadWidth="500"
                    height="300"
                    loadHeight="300"
                    loadDisplayMode="scaleToFit"
                />
            </Rectangle>
            <LayoutGroup
                id="textGroup"
                layoutDirection="vert"
                itemSpacings="[15, 15, 15, 15]"
            >
                <Label 
                    id="titleLabel"
                    wrap="true"
                    width="500"
                />
                <Label 
                    id="descriptionLabel"
                    wrap="true"
                    maxLines="3"
                    width="500"
                />
                <Label 
                    id="releaseLabel"
                    wrap="false"
                    width="500"
                />
                <Label 
                    id="timeLabel"
                    wrap="false"
                />
            </LayoutGroup>
        </LayoutGroup>

        <Group translation="[700, 170]">
            <LabelList 
                id="buttons"
                numRows="3"
                itemSpacing="[0, 10]"
                itemSize="[500, 50]"
            />
        </Group>
    </children>
</component>