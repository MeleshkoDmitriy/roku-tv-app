<?xml version="1.0" encoding="UTF-8" ?>
<component name="VideoScreen" extends="Rectangle">
    <script type="text/brightscript" uri="VideoScreen.brs" />

    <interface>
        <field id="content" type="node" />
        <field id="startIndex" type="int" alwaysNotify="true" />
        <field id="lastIndex" type="int" />
        <field id="isSeries" type="bool" />
        <field id="close" type="bool" />
    </interface>

    <children>
        <Video
            id="video"
            width="1280"
            height="720"
            translation="[0, 0]"
        />
    </children>
</component>
